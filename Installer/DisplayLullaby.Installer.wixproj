<Project Sdk="WixToolset.Sdk/7.0.1">
  <Import Project="..\Version.props" />
  <PropertyGroup>
    <!-- Explicit acceptance required by WiX v7; see https://wixtoolset.org/osmf/. -->
    <AcceptEula>wix7</AcceptEula>
    <OutputName>DisplayLullaby-$(DisplayLullabyVersion)-x64</OutputName>
    <OutputPath>..\Release\</OutputPath>
    <IntermediateOutputPath>obj\$(Configuration)\</IntermediateOutputPath>
    <InstallerPlatform>x64</InstallerPlatform>
    <DefineConstants>DisplayLullabyVersion=$(DisplayLullabyVersion);ReleaseDir=..\Release;AppProjectDir=..</DefineConstants>
    <SuppressIces>ICE91</SuppressIces>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="7.0.1" />
    <PackageReference Include="WixToolset.Util.wixext" Version="7.0.1" />
  </ItemGroup>
</Project>
